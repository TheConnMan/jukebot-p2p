{
  "manifest_version": 3,
  "name": "JukeBot P2P",
  "version": "0.3.6",
  "minimum_chrome_version": "116",
  "description": "Listen to YouTube and YouTube Music in sync with friends, browser to browser.",
  "permissions": ["offscreen", "sidePanel", "storage", "contextMenus", "notifications"],
  "host_permissions": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_title": "JukeBot P2P",
    "default_popup": "popup.html",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
